        "z_inflation_level",
        "z_growth_level",
        "z_inflation_acceleration",
        "z_growth_acceleration"
      ]
    },
    "M3": {
      "features": [
        "current_stance",
        "six_month_stance_inertia",
        "z_inflation_level",
        "z_growth_level",
        "z_inflation_acceleration",
        "z_growth_acceleration",
        "z_inflation_level_x_z_inflation_acceleration",
        "z_growth_level_x_z_growth_acceleration"
      ],
      "interaction_rule": "form exactly the two own-axis interactions after causal standardization"
