  "decision_rules": {
    "state_dependence_adds_stable_policy_information": "Proxy M3 improves both RMSE and MAE versus M2 full-sample; M3 is not worse than M1 on both RMSE and MAE full-sample; M3 RMSE is non-worse than M2 in at least two of three fixed subperiods; M3 RMSE remains favorable versus M2 under every leave-one-subperiod-out check.",
    "state_dependence_improves_only_recently": "M3 improvement is concentrated in 2020-2025 and absent from both earlier subperiods.",
    "state_dependence_not_enough_linear_speed_problem_persists": "M3 does not beat M1 on both primary continuous-error metrics and does not establish stable M3-vs-M2 improvement.",
    "state_dependence_era_dependent": "M3 has material full-sample improvement but incremental value reverses across major subperiods or leaveouts.",
    "inconclusive_state_dependence_evidence": "Conflicting diagnostics prevent classification."
  },
  "stop_rule": "Treasury transmission remains closed unless verdict is state_dependence_adds_stable_policy_information.",
