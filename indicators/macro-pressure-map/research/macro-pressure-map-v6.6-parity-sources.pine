//@version=6
indicator("Macro Pressure Map V6.6 Parity Sources", shorttitle="MPM V6.6 PARITY SRC", overlay=false)

// Issue #59 Stage-2 helper.
// Attach this helper together with the frozen Macro Pressure Map V6.6 to an
// SPY 1D chart, keep both market-proxy timeframes at D, then export chart data.
// The helper exports the same default source series requested by V6.6 while
// leaving the production V6.6 script unchanged.

marketTf = input.timeframe("D", "Market Proxy Timeframe")

f_req(symbol) =>
    request.security(symbol, marketTf, close, gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_off, ignore_invalid_symbol=true)

spy = f_req("AMEX:SPY")
iwm = f_req("AMEX:IWM")
rsp = f_req("AMEX:RSP")
xly = f_req("AMEX:XLY")
xlp = f_req("AMEX:XLP")
xli = f_req("AMEX:XLI")
xlu = f_req("AMEX:XLU")
copper = f_req("COMEX:HG1!")
gold = f_req("COMEX:GC1!")
breakeven10y = f_req("FRED:T10YIE")
oil = f_req("NYMEX:CL1!")
gasoline = f_req("NYMEX:RB1!")
commodityBasket = f_req("AMEX:DBC")
dxy = f_req("TVC:DXY")
vix = f_req("CBOE:VIX")
move = f_req("TVC:MOVE")
hyg = f_req("AMEX:HYG")
ief = f_req("NASDAQ:IEF")
hyOas = f_req("FRED:BAMLH0A0HYM2")
realYield = f_req("FRED:DFII10")

plot(spy, "PARITY SRC spy", display=display.data_window)
plot(iwm, "PARITY SRC iwm", display=display.data_window)
plot(rsp, "PARITY SRC rsp", display=display.data_window)
plot(xly, "PARITY SRC xly", display=display.data_window)
plot(xlp, "PARITY SRC xlp", display=display.data_window)
plot(xli, "PARITY SRC xli", display=display.data_window)
plot(xlu, "PARITY SRC xlu", display=display.data_window)
plot(copper, "PARITY SRC copper", display=display.data_window)
plot(gold, "PARITY SRC gold", display=display.data_window)
plot(breakeven10y, "PARITY SRC breakeven_10y", display=display.data_window)
plot(oil, "PARITY SRC oil", display=display.data_window)
plot(gasoline, "PARITY SRC gasoline", display=display.data_window)
plot(commodityBasket, "PARITY SRC commodity_basket", display=display.data_window)
plot(dxy, "PARITY SRC dxy", display=display.data_window)
plot(vix, "PARITY SRC vix", display=display.data_window)
plot(move, "PARITY SRC move", display=display.data_window)
plot(hyg, "PARITY SRC hyg", display=display.data_window)
plot(ief, "PARITY SRC ief", display=display.data_window)
plot(hyOas, "PARITY SRC hy_oas", display=display.data_window)
plot(realYield, "PARITY SRC real_yield", display=display.data_window)
